# Development Dockerfile for Express/Socket.IO backend
# Optimized for hot reloading with tsx watch

FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose backend port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:5000/health || exit 1

# Run with tsx watch for hot reloading during development
CMD ["npm", "run", "dev"]
