# Production Dockerfile for React/Vite frontend
# Multi-stage build: compile TypeScript/React → optimize static assets → minimal runtime

FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Copy source and build
COPY . .
RUN yarn build

# Production runtime: serve static assets with minimal footprint
FROM node:20-alpine AS production

WORKDIR /app

# Install only serve tool to run the production build
RUN npm install -g serve

# Copy built assets from build stage
COPY --from=build /app/dist ./dist

# Expose port for serving
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Run serve with production settings
CMD ["serve", "-s", "dist", "-l", "3000"]
